{
  "name": "yovibe-web",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node scripts/start-web.js",
    "build": "node scripts/build-web.js --clear",
    "build:web": "node scripts/build-web.js --clear",
    "build:clean": "node scripts/build-web.js --clear --experimental-bundle-splitting",
    "deploy": "netlify deploy --prod",
    "dev": "node scripts/start-web.js",
    "preview": "expo start --web --no-dev --minify",
    "clean": "expo start --clear",
    "reset": "expo install --fix && npm install",
    "clear-cache": "expo start --clear --web",
    "predeploy": "npm run build",
    "netlify:dev": "netlify dev",
    "meta-server": "node meta-server.js",
    "test-meta": "node test-meta-server.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-jest.js --silent",
    "test:watch": "jest --watch",
    "staging:schema": "node scripts/generate-staging-schema.js",
    "staging:scan": "node scripts/staging-safety-scan.js",
    "test:staging-security": "node scripts/staging-security-probe.js",
    "test:staging-performance": "node scripts/staging-performance-test.js",
    "test:staging-capacity": "node scripts/run-staging-capacity.js",
    "test:staging-post-contract": "node scripts/staging-post-contract-test.js",
    "test:staging-mocked-post": "node scripts/staging-mocked-provider-test.js",
    "test:staging-rate-ladder": "node scripts/staging-rate-ladder.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1046.0",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.16",
    "@react-navigation/native": "^6.1.14",
    "@react-navigation/native-stack": "^6.9.22",
    "@react-navigation/stack": "^6.3.25",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.106.0",
    "@tensorflow/tfjs": "^4.21.0",
    "crypto-browserify": "^3.12.0",
    "dotenv": "^17.4.2",
    "expo": "57.0.21",
    "expo-asset": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-modules-core": "~57.0.17",
    "expo-print": "~57.0.1",
    "expo-sharing": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "firebase": "^10.8.0",
    "firebase-admin": "^13.6.0",
    "html5-qrcode": "^2.3.8",
    "jszip": "^3.10.1",
    "path-browserify": "^1.0.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1303.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "^1.9.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "resend": "6.26.0",
    "stream-browserify": "^3.0.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@expo/server": "^0.7.5",
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.30",
    "@types/prop-types": "^15.7.11",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.3",
    "@types/uuid": "^9.0.8",
    "babel-plugin-module-resolver": "^5.0.0",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "netlify-cli": "^17.15.7",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/netlify/"
    ]
  },
  "private": true,
  "overrides": {
    "@xmldom/xmldom": "0.8.14",
    "tar": "7.5.22",
    "undici": "6.28.0"
  }
}
